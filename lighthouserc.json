{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/blog/hello-world/",
        "http://localhost/lab/astro-7-satteri/",
        "http://localhost/tags/",
        "http://localhost/cv/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 230000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 2048 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 60000 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
