    "@lucide/astro": "^1.48.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.9",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
