{
  "name": "bmscomp.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && pnpm validate:cv && astro build",
    "validate:cv": "node scripts/validate-resume.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "build:fixtures": "FIXTURES=1 astro build",
    "test": "node --test src/lib/markdown/",
    "test:e2e": "pnpm build:fixtures && playwright test",
    "measure": "pnpm build:fixtures && MEASURE=1 playwright test --project=light --project=dark"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
