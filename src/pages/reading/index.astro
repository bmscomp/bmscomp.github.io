---
import PageHeader from '../../components/PageHeader.astro';
import ReadingItem from '../../components/ReadingItem.astro';
import Section from '../../components/Section.astro';
import Base from '../../layouts/Base.astro';
import { getReadingByStatus } from '../../lib/reading';

const { reading, read, toRead } = await getReadingByStatus();
const sections = [
  { id: 'reading-now', title: 'Reading now', entries: reading },
  { id: 'read', title: 'Read', entries: read },
  { id: 'up-next', title: 'Up next', entries: toRead },
].filter((section) => section.entries.length > 0);
---

<Base title="Reading" description="Articles, books, and papers I'm reading, with short notes.">
  <link slot="head" rel="alternate" type="application/rss+xml" title="Reading" href="/reading/rss.xml" />
  <PageHeader
    kicker="Library"
    title="Reading"
    lede="Articles, books, and papers I'm reading or found worth keeping, with a line on why."
  >
    <p class="mt-5"><a href="/reading/rss.xml" class="pill">RSS feed</a></p>
  </PageHeader>
  {
    sections.length === 0 && (
      <p class="row italic text-muted">
        <span class="gutter" aria-hidden="true" />
        <span>Nothing here yet.</span>
      </p>
    )
  }
  {
    sections.map(({ id, title, entries }) => (
      <Section id={id} title={title} note={`${entries.length}`} variant="list">
        <ul>
          {entries.map((entry) => (
            <ReadingItem entry={entry} />
          ))}
        </ul>
      </Section>
    ))
  }
</Base>
