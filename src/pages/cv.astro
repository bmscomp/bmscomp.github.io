---
import Braces from '@lucide/astro/icons/braces';
import Printer from '@lucide/astro/icons/printer';
import { getEntry } from 'astro:content';
import Seal from '../components/cv/Seal.astro';
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import {
  abbreviateName,
  byDateDesc,
  EARLIER_BEFORE,
  formatLocation,
  formatLongMonth,
  formatMonth,
  formatYear,
  isEarlier,
  isTalk,
  listNames,
  toJsonLd,
  toRoman,
  typeset,
} from '../lib/cv';
import '../styles/cv.css';

const entry = await getEntry('cv', 'resume');
if (!entry) throw new Error('Missing src/content/cv/resume.json');
const resume = entry.data;
const { basics, work, projects, publications, education, skills, languages, interests } = resume;

const recent = work.filter((job) => !isEarlier(job));
const earlier = work.filter(isEarlier);
const openSource = projects.filter((p) => !isTalk(p));
const talks = projects.filter(isTalk).sort(byDateDesc);
const location = formatLocation(basics.location);
const updated = resume.meta?.lastModified;

const [firstName, ...lastNames] = basics.name.split(/\s+/);
const initials = `${firstName[0]}${lastNames.at(-1)?.[0] ?? ''}`;
const citedAuthor = abbreviateName(basics.name);
const ring = `${basics.name} · Curriculum Vitæ · ${toRoman(Number((updated ?? '2026').slice(0, 4)))} ·`.toUpperCase();

const facts = [
  { value: String(Math.min(...work.map((job) => Number(job.startDate.slice(0, 4))))), label: 'building software since' },
  { value: String(new Set(work.map((job) => job.name)).size), label: 'companies' },
  { value: String(openSource.length), label: 'open-source projects' },
  { value: String(talks.length), label: 'talks & workshops' },
];

const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
/** Typeset text and italicise the titles of our own publications wherever they are mentioned. */
const withCitations = (text: string) =>
  publications.reduce((html, pub) => html.replaceAll(typeset(pub.name), `<cite>${typeset(pub.name)}</cite>`), typeset(text));
const bookFor = (name: string) => publications.find((pub) => pub.name.startsWith(name));

const jsonLd = JSON.stringify(toJsonLd(resume, new URL('/cv/', Astro.site).href)).replace(/</g, '\\u003c');
---

<Base
  title="CV"
  description={`${basics.name} — ${basics.label}`}
  image="/og/cv.png"
>
  <Fragment slot="head">
    <link rel="alternate" type="application/json" title="JSON Resume" href="/cv.json" />
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="cv">
    <!-- Letterhead -->
    <header class="row items-center">
      <div class="gutter mb-5 flex sm:mb-0 sm:justify-end print:mb-0 print:justify-end">
        <Seal initials={initials} ring={ring} class="size-24 sm:size-[7.5rem] print:size-[5.2rem]" />
      </div>
      <div>
        <p class="kicker">Curriculum Vitæ</p>
        <h1 class="cv-name mt-1">{basics.name}</h1>
        <p class="cv-headline mt-2" set:html={typeset(basics.label)} />
        <address class="text-muted mt-3 flex flex-wrap gap-x-2 not-italic print:mt-1">
          {location && <span>{location}</span>}
          {
            basics.profiles.map((p) => (
              <>
                <span aria-hidden="true">·</span>
                <a href={p.url}>{shortUrl(p.url)}</a>
              </>
            ))
          }
        </address>
        <div class="mt-5 flex flex-wrap gap-2 print:hidden">
          <button type="button" id="print-cv" class="pill max-sm:hidden">
            <Printer class="size-4" aria-hidden="true" /> Save as PDF
          </button>
          <a href="/cv.json" class="pill"><Braces class="size-4" aria-hidden="true" /> JSON Resume</a>
        </div>
      </div>
    </header>

    <hr class="double-rule mt-8 print:mt-3" />

    <Section id="profile" title="Profile" class="print:mt-7!">
      <div class="row">
        <div class="gutter" aria-hidden="true"></div>
        <p class="hyphenate justified lede-caps" set:html={withCitations(basics.summary)} />
      </div>
      {
        interests.length > 0 && (
          <div class="row mt-3 print:mt-1">
            <p class="gutter label">expertise</p>
            <p
              class="italic"
              set:html={interests.map((i) => typeset(i.name)).join('<span class="text-muted not-italic">&nbsp;· </span>')}
            />
          </div>
        )
      }
      <div class="row mt-8 print:hidden">
        <div class="gutter" aria-hidden="true"></div>
        <dl class="cv-facts">
          {
            facts.map(({ value, label }) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Section>

    <Section id="experience" title="Experience">
      {
        recent.map((job) => {
          const current = !job.endDate;
          return (
            <div class="row entry">
              <p class="gutter date">
                <span class="sm:block print:block">{formatMonth(job.startDate)} –</span>{' '}
                <span class:list={['sm:block print:block', current && 'date-now']}>
                  {current ? 'present' : formatMonth(job.endDate)}
                </span>
              </p>
              <div>
                <h3 class="cv-role" set:html={typeset(job.position)} />
                <p class="cv-org">
                  {job.url ? <a href={job.url} set:html={typeset(job.name)} /> : <span set:html={typeset(job.name)} />}
                  {job.location && <span class="text-muted font-normal not-italic"> · {job.location}</span>}
                </p>
                {job.summary && <p class="hyphenate mt-1.5 print:mt-0.5" set:html={typeset(job.summary)} />}
                {job.highlights.length > 0 && (
                  <ul class="circle-list hyphenate mt-1.5 print:mt-0.5">
                    {job.highlights.map((h) => (
                      <li set:html={typeset(h)} />
                    ))}
                  </ul>
                )}
              </div>
            </div>
          );
        })
      }
    </Section>

    {
      earlier.length > 0 && (
        <Section id="earlier" title="Earlier experience" note={`before ${EARLIER_BEFORE}`}>
          {earlier.map((job) => (
            <div class="row entry-compact">
              <p class="gutter date">
                {formatYear(job.startDate)}–{formatYear(job.endDate)}
              </p>
              <div>
                <p>
                  <span class="font-semibold" set:html={typeset(job.position)} />,{' '}
                  <span class="cv-org" set:html={typeset(job.name)} />
                  {job.location && <span class="text-muted"> · {job.location}</span>}
                </p>
                {job.summary && (
                  <p class="text-muted hyphenate text-[0.95em] print:hidden" set:html={typeset(job.summary)} />
                )}
              </div>
            </div>
          ))}
        </Section>
      )
    }

    {
      publications.length > 0 && (
        <Section id="publications" title="Publications">
          {publications.map((pub) => (
            <div class="row entry-compact">
              <p class="gutter date">{pub.releaseDate && formatYear(pub.releaseDate)}</p>
              <div class="hyphenate">
                <p>
                  <span class="author-sc" set:html={typeset(pub.authors ?? citedAuthor)} />.{' '}
                  <cite>{pub.url ? <a href={pub.url} set:html={typeset(pub.name)} /> : <span set:html={typeset(pub.name)} />}</cite>.
                  {pub.publisher && <span set:html={` ${typeset(pub.publisher)}.`} />}
                  {pub.url && <span class="url-note"> {shortUrl(pub.url)}</span>}
                </p>
                {pub.summary && <p class="text-muted text-[0.95em] print:hidden" set:html={typeset(pub.summary)} />}
              </div>
            </div>
          ))}
        </Section>
      )
    }

    {
      openSource.length > 0 && (
        <Section id="open-source" title="Open-source work">
          <ol>
            {openSource.map((p, i) => {
              const book = bookFor(p.name);
              return (
                <li class="row entry-compact">
                  <p class="gutter ref">[{i + 1}]</p>
                  <div class="hyphenate">
                    <p>
                      {p.url ? (
                        <a href={p.url} class="font-semibold">
                          {p.name}
                        </a>
                      ) : (
                        <span class="font-semibold">{p.name}</span>
                      )}
                      {p.roles.length > 0 && <span class="text-muted italic"> — {p.roles.join(' & ').toLowerCase()}.</span>}{' '}
                      <span set:html={typeset(p.description)} />
                      {p.url && <span class="url-note print:hidden"> {shortUrl(p.url)}</span>}
                    </p>
                    {p.highlights.length > 0 && (
                      <ul class="circle-list mt-1 print:mt-0">
                        {p.highlights.map((h) => (
                          <li set:html={typeset(h)} />
                        ))}
                      </ul>
                    )}
                    {book && (
                      <p class="mt-1 print:mt-0">
                        <span class="label text-muted">book</span>{' '}
                        <cite>
                          <a href={book.url} set:html={typeset(book.name)} />
                        </cite>
                      </p>
                    )}
                    {p.keywords.length > 0 && <p class="keywords mt-1 print:hidden">{p.keywords.join('\u00a0· ')}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </Section>
      )
    }

    {
      talks.length > 0 && (
        <Section id="talks" title="Talks & workshops">
          {talks.map((t) => {
            const quoted = t.type === 'talk';
            // Chicago style: the period goes inside the quotes unless a bracketed translation follows.
            const title = quoted
              ? `“${typeset(t.name)}${t.translation ? '”' : '.”'}`
              : `${typeset(t.name)}${t.translation ? '' : '.'}`;
            return (
              <div class="row entry-compact">
                <p class="gutter date">
                  {t.startDate ? formatMonth(t.startDate.slice(0, 7)) : <span class="label">{t.type}</span>}
                </p>
                <div class="hyphenate">
                  <p>
                    {t.url ? (
                      <a href={t.url} class="font-semibold" set:html={title} />
                    ) : (
                      <span class="font-semibold" set:html={title} />
                    )}
                    {t.translation && (
                      <span class="text-muted">
                        {' '}
                        [<span set:html={typeset(t.translation)} />].
                      </span>
                    )}
                    {t.entity && (
                      <>
                        {' '}
                        <span class="italic" set:html={typeset(t.entity)} />
                      </>
                    )}
                    {t.with.length > 0 && <>, with {listNames(t.with.map(abbreviateName))}</>}
                    {t.url?.includes('youtube.com') && <span class="text-muted"> (recorded)</span>}.
                  </p>
                  <p class="text-muted text-[0.95em] print:hidden" set:html={typeset(t.description)} />
                </div>
              </div>
            );
          })}
        </Section>
      )
    }

    <Section id="education" title="Education">
      {
        education.map((e) => (
          <div class="row entry-compact">
            <p class="gutter date">{e.endDate && formatYear(e.endDate)}</p>
            <div class="hyphenate">
              <p>
                <span class="font-semibold" set:html={typeset(`${e.studyType} in ${e.area}`)} />
                {e.specialization && (
                  <>
                    , specialization in <span class="font-semibold" set:html={typeset(e.specialization)} />
                  </>
                )}
              </p>
              <p class="italic" set:html={typeset(e.institution)} />
            </div>
          </div>
        ))
      }
    </Section>

    <Section id="skills" title="Skills">
      {
        skills.map((group) => (
          <div class="row entry-compact">
            <p class="gutter label">{group.name}</p>
            <p class="hyphenate" set:html={group.keywords.map(typeset).join(', ')} />
          </div>
        ))
      }
    </Section>

    <Section id="languages" title="Languages">
      <div class="row">
        <div class="gutter" aria-hidden="true"></div>
        <p>{languages.map((l) => `${l.language} (${l.fluency.toLowerCase()})`).join('\u00a0· ')}</p>
      </div>
    </Section>

    <footer class="mt-14 text-center print:mt-3">
      <p class="fleuron" aria-hidden="true">❦</p>
      <p class="colophon mt-2 print:mt-0.5">
        {
          updated && (
            <>
              Last updated <time datetime={updated}>{formatLongMonth(updated)}</time>.{' '}
            </>
          )
        }
        Set in EB Garamond.
        <span class="print:hidden">
          Also available as <a href="/cv.json">JSON Resume</a>.
        </span>
      </p>
    </footer>
  </article>
</Base>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>
