---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('cv', 'resume');
if (!entry) throw new Error('Missing src/content/cv/resume.json');
const { basics, work, projects, education, skills, languages } = entry.data;

/** "2021-03" → "Mar 2021", "2019" → "2019". */
function formatMonth(value?: string) {
  if (!value) return 'Present';
  const [year, month] = value.split('-');
  if (!month) return year;
  return new Date(Number(year), Number(month) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<Base title="CV" description={`${basics.name} — ${basics.label}`}>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight">{basics.name}</h1>
    <p class="mt-1 text-lg text-zinc-600 dark:text-zinc-400">
      {basics.label}{basics.location && <span> · {basics.location.city}</span>}
    </p>
    {
      basics.profiles.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-4 text-sm">
          {basics.profiles.map((p) => (
            <li>
              <a href={p.url} class="text-accent">{p.network}</a>
            </li>
          ))}
        </ul>
      )
    }
    {basics.summary && <p class="mt-6 leading-relaxed">{basics.summary}</p>}
  </header>

  {
    work.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-zinc-500">Experience</h2>
        <ol class="space-y-8 border-l border-zinc-200 pl-6 dark:border-zinc-800">
          {work.map((job) => (
            <li class="relative">
              <span class="absolute -left-[1.85rem] top-2 size-2.5 rounded-full bg-accent" aria-hidden="true" />
              <p class="text-sm text-zinc-500">
                {formatMonth(job.startDate)} – {formatMonth(job.endDate)}
              </p>
              <h3 class="text-lg font-medium">
                {job.position} ·{' '}
                {job.url ? <a href={job.url} class="text-accent">{job.name}</a> : job.name}
              </h3>
              {job.summary && <p class="mt-1 text-zinc-600 dark:text-zinc-400">{job.summary}</p>}
              {job.highlights.length > 0 && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-zinc-600 dark:text-zinc-400">
                  {job.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-zinc-500">Open source</h2>
        <ul class="space-y-3">
          {projects.map((p) => (
            <li>
              <p>
                {p.url ? <a href={p.url} class="font-medium text-accent">{p.name}</a> : <span class="font-medium">{p.name}</span>}
                {p.roles.length > 0 && <span class="text-sm text-zinc-500"> · {p.roles.join(', ')}</span>}
              </p>
              <p class="text-zinc-600 dark:text-zinc-400">{p.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-zinc-500">Skills</h2>
        <dl class="space-y-3">
          {skills.map((group) => (
            <div class="sm:flex sm:gap-4">
              <dt class="font-medium sm:w-40 sm:shrink-0">{group.name}</dt>
              <dd class="flex flex-wrap gap-2">
                {group.keywords.map((k) => (
                  <span class="rounded bg-zinc-100 px-2 py-0.5 text-sm dark:bg-zinc-800">{k}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    education.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-zinc-500">Education</h2>
        <ul class="space-y-3">
          {education.map((e) => (
            <li>
              <p class="font-medium">{e.studyType}, {e.area}</p>
              <p class="text-sm text-zinc-500">
                {e.institution}
                {e.endDate && <span> · {formatMonth(e.endDate)}</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    languages.length > 0 && (
      <section>
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-zinc-500">Languages</h2>
        <p>{languages.map((l) => `${l.language} (${l.fluency})`).join(' · ')}</p>
      </section>
    )
  }
</Base>
