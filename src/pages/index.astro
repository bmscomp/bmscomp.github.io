---
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 5);
---

<Base>
  <section class="mb-12">
    <h1 class="text-3xl font-bold tracking-tight">Hi, I'm Said.</h1>
    <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">
      Software engineer. I write about what I build, the software and systems I test, the articles
      I read, and the places I travel to.
    </p>
  </section>
  <section>
    <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-zinc-500">Latest posts</h2>
    <PostList posts={latest} />
    <p class="mt-8"><a href="/blog/" class="text-accent">All posts →</a></p>
  </section>
</Base>
