---
import Colophon from '../components/Colophon.astro';
import LabList from '../components/LabList.astro';
import PageHeader from '../components/PageHeader.astro';
import PostList from '../components/PostList.astro';
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { getLabNotes } from '../lib/lab';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 5);
const lab = (await getLabNotes()).slice(0, 3);
---

<Base>
  <PageHeader
    kicker="Welcome"
    title="Hi, I'm Said."
    lede="Software engineer. I write about what I build, the software and systems I test, the articles I read, and the places I travel to."
  >
    <p class="mt-5 flex flex-wrap gap-2">
      <a href="/cv/" class="pill">Curriculum vitæ</a>
      <a href="/rss.xml" class="pill">RSS feed</a>
    </p>
  </PageHeader>

  <Section id="latest" title="Latest posts" variant="list">
    <PostList posts={latest} />
    <p class="row mt-6">
      <span class="gutter" aria-hidden="true"></span>
      <a href="/blog/" class="label">All posts →</a>
    </p>
  </Section>

  {
    lab.length > 0 && (
      <Section id="lab" title="From the lab" variant="list">
        <LabList notes={lab} />
        <p class="row mt-6">
          <span class="gutter" aria-hidden="true" />
          <a href="/lab/" class="label">All lab notes →</a>
        </p>
      </Section>
    )
  }
  <Colophon />
</Base>
