---
import Colophon from '../../components/Colophon.astro';
import LabList from '../../components/LabList.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { filterGroups, getLabNotes } from '../../lib/lab';

const notes = await getLabNotes();
// W6.4: a filter group appears only when it has two or more values, and the bar only with a group.
const groups = Object.entries(filterGroups(notes));
---

<Base title="Lab" description="Software, systems, and hardware I'm testing — setup, results, and verdicts.">
  <link slot="head" rel="alternate" type="application/rss+xml" title="Lab" href="/lab/rss.xml" />
  <PageHeader
    kicker="Notebook"
    title="Lab"
    lede="Software, systems, and hardware I'm testing on my machines — how I set them up, what happened, and whether they stayed."
  >
    <p class="mt-5"><a href="/lab/rss.xml" class="pill">RSS feed</a></p>
  </PageHeader>

  {
    groups.length > 0 && (
      <div id="lab-filters" class="space-y-2" hidden>
        {groups.map(([key, values]) => (
          <div class="row items-center" data-filter={key} role="group" aria-labelledby={`filter-${key}`}>
            <span id={`filter-${key}`} class="gutter label">
              {key}
            </span>
            <div class="flex flex-wrap gap-2">
              {['all', ...values].map((value) => (
                <button type="button" class="pill" data-value={value} aria-pressed={value === 'all' ? 'true' : 'false'}>
                  {value}
                </button>
              ))}
            </div>
          </div>
        ))}
        <p id="lab-count" class="sr-only" aria-live="polite" />
      </div>
    )
  }

  {
    notes.length > 0 && (
      <div class:list={[groups.length > 0 && 'mt-8']}>
        <LabList notes={notes} id="lab-notes" headingLevel={2} />
      </div>
    )
  }
  {/* With no notes at all, the same line says so, and shows without JavaScript. */}
  <p id="lab-empty" class:list={['row italic text-muted', notes.length > 0 && 'mt-4']} hidden={notes.length > 0}>
    <span class="gutter" aria-hidden="true"></span>
    <span>{notes.length > 0 ? 'No notes match these filters.' : 'No notes yet.'}</span>
  </p>
  <Colophon />
</Base>

<script>
  // Filters come from the URL (?status=…&category=…) whether or not the bar is shown, so links from
  // articles keep working; the buttons, when there are any, only change them.
  const bar = document.getElementById('lab-filters');
  const count = document.getElementById('lab-count');
  const items = [...document.querySelectorAll<HTMLElement>('#lab-notes > li')];
  const empty = document.getElementById('lab-empty')!;
  const params = new URLSearchParams(location.search);
  const active: Record<string, string> = { status: 'all', category: 'all' };

  for (const key of Object.keys(active)) {
    const value = params.get(key);
    if (value && items.some((item) => item.dataset[key] === value)) active[key] = value;
  }

  function apply(announce: boolean) {
    let shown = 0;
    for (const item of items) {
      const match = Object.entries(active).every(([key, value]) => value === 'all' || item.dataset[key] === value);
      item.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
    for (const group of bar?.querySelectorAll<HTMLElement>('[data-filter]') ?? []) {
      for (const button of group.querySelectorAll<HTMLButtonElement>('button')) {
        button.setAttribute('aria-pressed', String(button.dataset.value === active[group.dataset.filter!]));
      }
    }
    if (announce && count) count.textContent = `${shown} ${shown === 1 ? 'note' : 'notes'} shown`;
  }

  if (bar) {
    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('button');
      const group = button?.closest<HTMLElement>('[data-filter]');
      if (!button || !group) return;
      active[group.dataset.filter!] = button.dataset.value!;
      apply(true);
      const query = new URLSearchParams(Object.entries(active).filter(([, value]) => value !== 'all'));
      history.replaceState(null, '', query.size ? `?${query}` : location.pathname);
    });
    bar.hidden = false;
  }
  apply(false);
</script>
