---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map(({ slug, name, posts }) => ({ params: { tag: slug }, props: { name, posts } }));
}

const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`Posts tagged ${name}`}>
  <h1 class="mb-2 text-3xl font-bold tracking-tight">#{name}</h1>
  <p class="mb-8 text-zinc-500">
    {posts.length} post{posts.length === 1 ? '' : 's'} · <a href="/tags/" class="text-accent">all tags</a>
  </p>
  <PostList posts={posts} />
</Base>
