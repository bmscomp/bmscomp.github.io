---
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map(({ slug, name, posts }) => ({ params: { tag: slug }, props: { name, posts } }));
}

const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`Posts tagged ${name}`}>
  <PageHeader
    kicker="Tag"
    kickerHref="/tags/"
    title={`#${name}`}
    lede={`${posts.length} post${posts.length === 1 ? '' : 's'} on this topic.`}
  />
  <div>
    <PostList posts={posts} />
  </div>
  <p class="row mt-8">
    <span class="gutter" aria-hidden="true"></span>
    <a href="/tags/" class="label">All tags →</a>
  </p>
</Base>
