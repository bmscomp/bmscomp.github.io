---
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/posts';

const tags = await getTags();
---

<Base title="Tags" description="Posts grouped by topic">
  <h1 class="mb-8 text-3xl font-bold tracking-tight">Tags</h1>
  <ul class="flex flex-wrap gap-3">
    {
      tags.map(({ slug, name, posts }) => (
        <li>
          <a
            href={`/tags/${slug}/`}
            class="block rounded-md border border-zinc-200 px-3 py-1.5 no-underline hover:border-accent hover:text-accent dark:border-zinc-800"
          >
            #{name} <span class="text-sm text-zinc-500">{posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
