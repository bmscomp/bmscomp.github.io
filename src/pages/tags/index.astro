---
import Colophon from '../../components/Colophon.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/posts';

const tags = await getTags();
---

<Base title="Tags" description="Posts grouped by topic">
  <PageHeader kicker="Index" title="Tags" lede="Posts grouped by topic." />
  <div class="row">
    <p class="gutter label pt-1">{tags.length} topics</p>
    <ul class="flex flex-wrap gap-2">
      {
        tags.map(({ slug, name, posts }) => (
          <li>
            <a href={`/tags/${slug}/`} class="pill">
              #{name} <span class="pill-count">{posts.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <Colophon />
</Base>
