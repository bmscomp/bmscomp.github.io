---
import Colophon from '../../components/Colophon.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog" description="Essays, announcements and how-tos, newest first.">
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog" href="/blog/rss.xml" />
  <PageHeader kicker="Writing" title="Blog" lede="Essays, announcements and how-tos, newest first.">
    <p class="mt-5"><a href="/blog/rss.xml" class="pill">RSS feed</a></p>
  </PageHeader>
  <div>
    <PostList posts={posts} headingLevel={2} />
  </div>
  <Colophon />
</Base>
