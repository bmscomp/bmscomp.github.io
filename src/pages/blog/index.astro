---
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog" description="Articles and notes, newest first.">
  <PageHeader kicker="Writing" title="Blog" lede="Articles and notes, newest first.">
    <p class="mt-5"><a href="/rss.xml" class="pill">RSS feed</a></p>
  </PageHeader>
  <div class="mt-10">
    <PostList posts={posts} />
  </div>
</Base>
