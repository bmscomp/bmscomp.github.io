---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import { typeset } from '../lib/typeset';
import TagList from './TagList.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  /** h2 where the list is the page's content, h3 inside a Section (W6.4: no skipped levels). */
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class="body-size">
  {
    posts.map((post) => (
      <li class="row entry">
        <p class="gutter date">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </p>
        <div>
          <Heading class="entry-title">
            <a href={`/blog/${post.id}/`} set:html={typeset(post.data.title)} />
            {post.data.draft && <span class="label text-muted"> · draft</span>}
          </Heading>
          <p class="entry-desc hyphenate mt-0.5 text-muted" set:html={typeset(post.data.description)} />
          <TagList tags={post.data.tags} class="mt-1" />
        </div>
      </li>
    ))
  }
</ol>
