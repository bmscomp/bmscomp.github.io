---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="space-y-6">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="group block no-underline">
          <time datetime={post.data.pubDate.toISOString()} class="text-sm text-zinc-500">
            {formatDate(post.data.pubDate)}
          </time>
          <h3 class="text-lg font-medium group-hover:text-accent">
            {post.data.title}
            {post.data.draft && <span class="ml-2 text-xs text-amber-600">draft</span>}
          </h3>
          <p class="text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>
