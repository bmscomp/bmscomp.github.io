---
import type { ReadingEntry } from '../lib/reading';
import { typeset } from '../lib/typeset';

interface Props {
  entry: ReadingEntry;
}

const { id, data } = Astro.props.entry;
const { title, url, author, kind, rating, tags, note, finishedDate, addedDate } = data;
const site = url ? new URL(url).hostname.replace(/^www\./, '') : undefined;
const date = finishedDate ?? addedDate;
---

<li id={id} class="row entry-compact">
  <p class="gutter date">
    <time datetime={date.toISOString()}>
      {date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
    </time>
    {kind !== 'article' && <span class="block">{kind}</span>}
  </p>
  <div class="hyphenate">
    <p>
      {
        url ? (
          <a href={url} rel="noopener" class="font-semibold" set:html={typeset(title)} />
        ) : (
          <span class="font-semibold" set:html={typeset(title)} />
        )
      }
      {author && <span class="author-sc">, {author}</span>}
      {site && <span class="url-note"> {site}</span>}
      {
        rating && (
          <span class="ml-1 text-accent" role="img" aria-label={`Rated ${rating} out of 5`}>
            {'★'.repeat(rating)}
            <span class="text-rule">{'★'.repeat(5 - rating)}</span>
          </span>
        )
      }
    </p>
    {note && <p class="text-muted italic" set:html={typeset(note)} />}
    {tags.length > 0 && <p class="keywords">{tags.map((t) => `#${t}`).join('  ')}</p>}
  </div>
</li>
