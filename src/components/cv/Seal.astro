---
// A university-style seal: initials in the centre, name and title set around the ring.
interface Props {
  initials: string;
  ring: string;
  class?: string;
}

const { initials, ring, class: className } = Astro.props;
const id = `seal-${initials.toLowerCase()}`;
// Circumference of the text path (r = 46.5) minus a little air before the ring closes.
const ringLength = Math.round(2 * Math.PI * 46.5) - 3;
---

<svg viewBox="0 0 120 120" class:list={['cv-seal', className]} aria-hidden="true">
  <defs>
    <path id={id} d="M 13.5,60 a 46.5,46.5 0 1,1 93,0 a 46.5,46.5 0 1,1 -93,0" />
  </defs>
  <circle cx="60" cy="60" r="58.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
  <circle cx="60" cy="60" r="55.5" fill="none" stroke="currentColor" stroke-width="0.5"></circle>
  <circle cx="60" cy="60" r="38.5" fill="none" stroke="currentColor" stroke-width="0.7"></circle>
  <text font-size="8.4" fill="currentColor" style="font-variant-caps: normal; letter-spacing: 0">
    <textPath href={`#${id}`} textLength={ringLength} lengthAdjust="spacing">{ring}</textPath>
  </text>
  <text
    x="60"
    y="70.5"
    text-anchor="middle"
    font-size="31"
    font-style="italic"
    font-weight="500"
    fill="currentColor"
    style="font-variant-numeric: lining-nums">{initials}</text
  >
</svg>
