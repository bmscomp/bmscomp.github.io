---
// A document section: accent bar in the margin column and a small-caps title, like LaTeX CV classes.
interface Props {
  id: string;
  title: string;
  note?: string;
  /** "list": on list pages the title must outrank the entry titles under it (W4.7). */
  variant?: 'document' | 'list';
  class?: string;
}

const { id, title, note, variant = 'document', class: className } = Astro.props;
---

<section aria-labelledby={id} class:list={['section', variant === 'list' && 'heading-list', className]}>
  <h2 id={id} class="heading" aria-label={note ? `${title}, ${note}` : undefined}>
    <span class="heading-bar" aria-hidden="true"></span>
    <span class="heading-text">
      {title}
      {note && <span class="heading-note">{note}</span>}
    </span>
  </h2>
  <slot />
</section>
