---
import { SITE_TITLE } from '../consts';

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/tags/', label: 'Tags' },
];
const path = Astro.url.pathname;
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a href="/" class="font-semibold no-underline hover:text-accent">{SITE_TITLE}</a>
    <ul class="flex gap-5 text-sm">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['no-underline hover:text-accent', path.startsWith(href) && 'text-accent']}
              aria-current={path.startsWith(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
