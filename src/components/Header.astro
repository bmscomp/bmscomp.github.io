---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

// Reading appears in the nav once it has at least one entry.
const hasReading = (await getCollection('reading')).length > 0;
const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/lab/', label: 'Lab' },
  ...(hasReading ? [{ href: '/reading/', label: 'Reading' }] : []),
  { href: '/cv/', label: 'CV' },
  { href: '/tags/', label: 'Tags' },
];
const path = Astro.url.pathname;
---

<header class="print:hidden border-b border-zinc-200 dark:border-zinc-800">
  <nav class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
    <a href="/" class="font-semibold whitespace-nowrap no-underline hover:text-accent">{SITE_TITLE}</a>
    <ul class="flex gap-4 text-sm sm:gap-5">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['no-underline hover:text-accent', path.startsWith(href) && 'text-accent']}
              aria-current={path.startsWith(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
