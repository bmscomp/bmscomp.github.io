---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

// Reading appears in the nav once it has at least one entry.
const hasReading = (await getCollection('reading')).length > 0;
const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/lab/', label: 'Lab' },
  ...(hasReading ? [{ href: '/reading/', label: 'Reading' }] : []),
  { href: '/cv/', label: 'CV' },
  { href: '/tags/', label: 'Tags' },
];
const path = Astro.url.pathname;
const initials = SITE_TITLE.split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<header
  class="z-30 border-b border-rule bg-page/85 backdrop-blur-md sm:sticky sm:top-0 sm:min-h-(--header-h) print:hidden"
>
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-8 gap-y-1 px-6 py-2.5 sm:px-4"
  >
    <a href="/" class="group flex items-center gap-3 py-1 text-ink no-underline">
      <span class="monogram" aria-hidden="true">{initials}</span>
      <span class="text-[1.35rem] leading-none font-medium tracking-tight transition-colors group-hover:text-accent">
        {SITE_TITLE}
      </span>
    </a>
    <ul class="flex items-center gap-x-6 sm:gap-x-7">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class="nav-link" aria-current={path.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
