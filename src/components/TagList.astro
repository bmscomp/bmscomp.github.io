---
import { tagSlug } from '../lib/articles';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['keywords flex flex-wrap gap-x-3 gap-y-1', className]}>
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tagSlug(tag)}/`} class="inline-block py-[.2rem] text-muted no-underline hover:text-accent">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
