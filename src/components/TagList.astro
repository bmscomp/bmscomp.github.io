---
import { tagSlug } from '../lib/posts';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2 text-xs">
      {tags.map((tag) => (
        <li>
          <a
            href={`/tags/${tagSlug(tag)}/`}
            class="rounded bg-zinc-100 px-2 py-0.5 no-underline hover:text-accent dark:bg-zinc-800"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
