---
import { tagSlug } from '../lib/posts';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['keywords flex flex-wrap gap-x-3', className]}>
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tagSlug(tag)}/`} class="text-muted no-underline hover:text-accent">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
