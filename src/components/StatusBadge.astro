---
import type { LabStatus } from '../lib/lab';

interface Props {
  status: LabStatus;
  /** Link to the matching /lab/ filter, when that filter is shown. */
  href?: string;
}

const { status, href } = Astro.props;
---

{
  href ? (
    <a class="status" data-status={status} href={href}>
      {status}
    </a>
  ) : (
    <span class="status" data-status={status}>
      {status}
    </span>
  )
}
