---
import type { LabStatus } from '../lib/lab';

interface Props {
  status: LabStatus;
}

const { status } = Astro.props;
const styles: Record<LabStatus, string> = {
  testing: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
  adopted: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
  dropped: 'bg-zinc-200 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-400',
};
---

<span class:list={['rounded-full px-2 py-0.5 text-xs font-medium', styles[status]]}>{status}</span>
