---
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import TagList from '../components/TagList.astro';
import { formatDate } from '../lib/posts';
import Base from './Base.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { id, data } = Astro.props.post;
const { title, description, pubDate, updatedDate, tags } = data;
---

<Base title={title} description={description} image={`/og/${id}.png`} type="article">
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
      <p class="mt-2 text-sm text-zinc-500">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · updated {formatDate(updatedDate)}</span>}
      </p>
      <div class="mt-3"><TagList tags={tags} /></div>
    </header>
    <div
      class="prose prose-zinc max-w-none dark:prose-invert prose-a:text-accent prose-code:before:content-none prose-code:after:content-none"
    >
      <slot />
    </div>
  </article>
</Base>
