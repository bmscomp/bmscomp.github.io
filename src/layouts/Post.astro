---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import Base from './Base.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { title, description, pubDate, updatedDate, tags } = Astro.props.post.data;
---

<Base title={title} description={description}>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
      <p class="mt-2 text-sm text-zinc-500">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · updated {formatDate(updatedDate)}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2 text-xs">
            {tags.map((tag) => (
              <li class="rounded bg-zinc-100 px-2 py-0.5 dark:bg-zinc-800">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose prose-zinc max-w-none dark:prose-invert prose-a:text-accent prose-code:before:content-none prose-code:after:content-none">
      <slot />
    </div>
  </article>
</Base>
