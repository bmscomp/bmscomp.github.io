---
import { type CollectionEntry, render } from 'astro:content';
import TagLinks from '../components/TagLinks.astro';
import { getArticles, neighbours } from '../lib/articles';
import { getPosts } from '../lib/posts';
import { resolveRelated } from '../lib/related';
import { seriesPosition } from '../lib/series';
import Article from './Article.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { id, body, data } = post;
const rendered = await render(post);
const { older, newer } = neighbours(await getPosts(), id);
const link = (p?: CollectionEntry<'posts'>) => p && { href: `/blog/${p.id}/`, title: p.data.title };
const href = `/blog/${id}/`;
const related = await resolveRelated([...data.relatedPosts, ...data.relatedLab]);
const position = seriesPosition(await getArticles(), { id, series: data.series, seriesPart: data.seriesPart, href, title: data.title });
const series = position && {
  ...position,
  parts: position.parts.map((p) => ({ href: p.href, title: p.title, part: p.seriesPart!, current: p.href === href })),
};
---

<Article
  section="blog"
  title={data.title}
  description={data.description}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  image={`/og/${id}.png`}
  rendered={rendered}
  body={body}
  toc={data.toc}
  older={link(older)}
  newer={link(newer)}
  related={related}
  series={series}
>
  <Fragment slot="facts">
    {
      data.tags.length > 0 && (
        <div class="row">
          <dt class="gutter label">filed under</dt>
          <dd>
            <TagLinks tags={data.tags} />
          </dd>
        </div>
      )
    }
  </Fragment>
  <Fragment slot="end">
    {
      data.tags.length > 0 && (
        <div class="row">
          <dt class="gutter label">filed under</dt>
          <dd>
            <TagLinks tags={data.tags} />
          </dd>
        </div>
      )
    }
  </Fragment>
</Article>
