---
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import TagList from '../components/TagList.astro';
import { formatDate } from '../lib/posts';
import Base from './Base.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { id, data } = Astro.props.post;
const { title, description, pubDate, updatedDate, tags } = data;
---

<Base title={title} description={description} image={`/og/${id}.png`} type="article">
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  <article>
    <PageHeader kicker="Blog" kickerHref="/blog/" title={title} lede={description}>
      <time slot="gutter" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </PageHeader>
    <div class="row">
      <aside class="gutter max-sm:mb-6">
        {
          updatedDate && (
            <p class="date">
              updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </p>
          )
        }
        <TagList tags={tags} class="sm:flex-col sm:items-end" />
      </aside>
      <div class="prose prose-paper">
        <slot />
      </div>
    </div>
  </article>
</Base>
