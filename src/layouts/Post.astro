---
import { type CollectionEntry, render } from 'astro:content';
import { neighbours } from '../lib/articles';
import { getPosts, tagSlug } from '../lib/posts';
import Article from './Article.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { id, body, data } = post;
const rendered = await render(post);
const { older, newer } = neighbours(await getPosts(), id);
const link = (p?: CollectionEntry<'posts'>) => p && { href: `/blog/${p.id}/`, title: p.data.title };
const filed = data.tags.map((tag) => `<a href="/tags/${tagSlug(tag)}/">${tag}</a>`).join(' · ');
---

<Article
  section="blog"
  title={data.title}
  description={data.description}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  image={`/og/${id}.png`}
  rendered={rendered}
  body={body}
  toc={data.toc}
  older={link(older)}
  newer={link(newer)}
>
  <Fragment slot="facts">
    {
      data.tags.length > 0 && (
        <div class="row">
          <dt class="gutter label">filed under</dt>
          <dd set:html={filed} />
        </div>
      )
    }
  </Fragment>
  <Fragment slot="end">
    {
      data.tags.length > 0 && (
        <div class="row">
          <dt class="gutter label">filed under</dt>
          <dd set:html={filed} />
        </div>
      )
    }
  </Fragment>
</Article>
