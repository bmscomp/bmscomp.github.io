---
import { type CollectionEntry, render } from 'astro:content';
import TagLinks from '../components/TagLinks.astro';
import { getArticles, neighbours } from '../lib/articles';
import { getMathArticles } from '../lib/mathematics';
import { getPosts } from '../lib/posts';
import { articleHref, resolveRelated } from '../lib/related';
import { seriesPosition } from '../lib/series';
import Article from './Article.astro';

// A blog post or a mathematics article: both are set as papers.
interface Props {
  post: CollectionEntry<'posts'> | CollectionEntry<'mathematics'>;
}

const { post } = Astro.props;
const { id, body, data, collection } = post;
const math = collection === 'mathematics';
const rendered = await render(post);
const siblings: { id: string; data: { title: string } }[] = math ? await getMathArticles() : await getPosts();
const { older, newer } = neighbours(siblings, id);
const link = (p?: { id: string; data: { title: string } }) => p && { href: articleHref(collection, p.id), title: p.data.title };
const href = articleHref(collection, id);
const related = await resolveRelated([...data.relatedPosts, ...data.relatedMath, ...data.relatedLab]);
const position = seriesPosition(await getArticles(), { id, series: data.series, seriesPart: data.seriesPart, href, title: data.title });
const series = position && {
  ...position,
  parts: position.parts.map((p) => ({ href: p.href, title: p.title, part: p.seriesPart!, current: p.href === href })),
};
---

<Article
  section={math ? 'mathematics' : 'blog'}
  title={data.title}
  description={data.description}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  image={math ? `/og/mathematics/${id}.png` : `/og/${id}.png`}
  rendered={rendered}
  body={body}
  toc={data.toc}
  older={link(older)}
  newer={link(newer)}
  related={related}
  series={series}
  abstract={data.abstract}
  msc={data.msc}
>
  <Fragment slot="end">
    {
      data.tags.length > 0 && (
        <div class="row">
          <dt class="gutter label">filed under</dt>
          <dd>
            <TagLinks tags={data.tags} />
          </dd>
        </div>
      )
    }
  </Fragment>
</Article>
