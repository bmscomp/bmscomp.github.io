---
import 'katex/dist/katex.min.css';
import PageHeader from '../components/PageHeader.astro';
import StatusBadge from '../components/StatusBadge.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import { typeset } from '../lib/typeset';
import Base from './Base.astro';

interface Props {
  note: CollectionEntry<'lab'> | CollectionEntry<'fixtures'>;
  noindex?: boolean;
}

const { note, noindex } = Astro.props;
const { id, data } = note;
const { title, description, pubDate, updatedDate, category, status, tools, platform, verdict, repo } = data;
const facts = [
  { label: 'category', html: `<span class="label">${category}</span>` },
  platform && { label: 'platform', html: typeset(platform) },
  tools.length > 0 && { label: 'tools', html: tools.map(typeset).join(', ') },
  repo && { label: 'code', html: `<a href="${repo}">${repo.replace(/^https?:\/\//, '')}</a>` },
  verdict && { label: 'verdict', html: `<em>${typeset(verdict)}</em>` },
].filter((fact): fact is { label: string; html: string } => Boolean(fact));
---

<Base title={title} description={description} image={`/og/lab/${id}.png`} type="article" noindex={noindex}>
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  <article class="article">
    <PageHeader kicker="Lab" kickerHref="/lab/" title={title} lede={description}>
      <time slot="gutter" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </PageHeader>

    <dl class="space-y-1">
      <div class="row">
        <dt class="gutter label">status</dt>
        <dd><StatusBadge status={status} /></dd>
      </div>
      {
        facts.map(({ label, html }) => (
          <div class="row">
            <dt class="gutter label">{label}</dt>
            <dd class="hyphenate" set:html={html} />
          </div>
        ))
      }
      {
        updatedDate && (
          <div class="row">
            <dt class="gutter label">updated</dt>
            <dd class="date p-0">
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </dd>
          </div>
        )
      }
    </dl>

    <div class="row mt-8">
      <span class="gutter" aria-hidden="true"></span>
      <div class="prose prose-paper">
        <slot />
      </div>
    </div>
  </article>
</Base>
