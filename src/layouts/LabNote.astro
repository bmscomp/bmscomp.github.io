---
import { type CollectionEntry, render } from 'astro:content';
import StatusBadge from '../components/StatusBadge.astro';
import { getArticles, neighbours, tagSlug } from '../lib/articles';
import { filterGroups, getLabNotes } from '../lib/lab';
import { resolveRelated } from '../lib/related';
import { seriesPosition } from '../lib/series';
import { typeset } from '../lib/typeset';
import Article from './Article.astro';

interface Props {
  note: CollectionEntry<'lab'> | CollectionEntry<'fixtures'>;
  noindex?: boolean;
}

const { note, noindex } = Astro.props;
const { id, body, data } = note;
const { title, description, category, status, tools, platform, verdict, repo } = data;
const rendered = await render(note);
const notes = await getLabNotes();
const { older, newer } = note.collection === 'lab' ? neighbours(notes, id) : {};
const link = (n?: CollectionEntry<'lab'>) => n && { href: `/lab/${n.id}/`, title: n.data.title };

// Status and category link to the /lab/ filters, but only to filter groups that page shows.
const groups = filterGroups(notes);
const statusHref = groups.status && `/lab/?status=${status}`;
const categoryHref = groups.category && `/lab/?category=${category}`;
const categoryName = category[0].toUpperCase() + category.slice(1);
const toolList = tools.map(typeset).join(', ');
const repoLink = repo && `<a href="${repo}">${repo.replace(/^https?:\/\//, '')}</a>`;
const filed = data.tags.map((tag) => `<a href="/tags/${tagSlug(tag)}/">${tag}</a>`).join(' · ');
const related = await resolveRelated([...data.relatedPosts, ...data.relatedLab]);
const position = seriesPosition(await getArticles(), { id, series: data.series, seriesPart: data.seriesPart, href: `/lab/${id}/`, title });
const series = position && {
  ...position,
  parts: position.parts.map((p) => ({ href: p.href, title: p.title, part: p.seriesPart!, current: p.id === id })),
};
---

<Article
  section="lab"
  crumbs={[{ label: categoryName, href: categoryHref }]}
  title={title}
  description={description}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  image={`/og/lab/${id}.png`}
  rendered={rendered}
  body={body}
  toc={data.toc}
  older={link(older)}
  newer={link(newer)}
  related={related}
  series={series}
  noindex={noindex}
>
  <Fragment slot="facts">
    <div class="row facts-inline">
      <dt class="gutter label">status</dt>
      <dd><StatusBadge status={status} href={statusHref} /></dd>
    </div>
    {
      platform && (
        <div class="row facts-inline">
          <dt class="gutter label">platform</dt>
          <dd class="hyphenate" set:html={typeset(platform)} />
        </div>
      )
    }
    {
      verdict && (
        <div class="row facts-wide">
          <dt class="gutter label">verdict</dt>
          <dd class="hyphenate">
            <em set:html={typeset(verdict)} />
          </dd>
        </div>
      )
    }
  </Fragment>
  <Fragment slot="end">
    <div class="row">
      <dt class="gutter label">filed under</dt>
      {
        filed ? (
          <dd set:html={filed} />
        ) : (
          <dd>
            <a href="/lab/">Lab</a> · {categoryHref ? <a href={categoryHref}>{categoryName}</a> : categoryName}
          </dd>
        )
      }
    </div>
    {
      verdict && (
        <div class="row end-narrow">
          <dt class="gutter label">verdict</dt>
          <dd class="hyphenate">
            <em set:html={typeset(verdict)} />
          </dd>
        </div>
      )
    }
    {
      tools.length > 0 && (
        <div class="row">
          <dt class="gutter label">tools</dt>
          <dd class="hyphenate" set:html={toolList} />
        </div>
      )
    }
    {
      repoLink && (
        <div class="row">
          <dt class="gutter label">code</dt>
          <dd set:html={repoLink} />
        </div>
      )
    }
  </Fragment>
</Article>
